@namespace Clerk.Blazor.Internal
@if (TotalCount > PageSize)
{
    <nav class="cb-pager" aria-label="Pagination">
        <span class="cb-pager__info">@((Page - 1) * PageSize + 1)–@Math.Min(Page * PageSize, TotalCount) / @TotalCount</span>
        <button type="button" class="cb-btn cb-btn--ghost cb-btn--sm" disabled="@(Page <= 1)" @onclick="() => PageChanged.InvokeAsync(Page - 1)">@PreviousText</button>
        <button type="button" class="cb-btn cb-btn--ghost cb-btn--sm" disabled="@(Page * PageSize >= TotalCount)" @onclick="() => PageChanged.InvokeAsync(Page + 1)">@NextText</button>
    </nav>
}

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public string PreviousText { get; set; } = "Previous";
    [Parameter] public string NextText { get; set; } = "Next";
}
