@namespace Clerk.Blazor.Internal
@if (Count > 0)
{
    <button type="button" class="cb-link cb-center" @onclick="OnClick">@Text</button>
}

@code {
    [Parameter] public int Count { get; set; }
    [Parameter] public string Text { get; set; } = "Use another method";
    [Parameter] public EventCallback OnClick { get; set; }
}
