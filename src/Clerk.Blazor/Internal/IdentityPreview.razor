@namespace Clerk.Blazor.Internal
@if (!string.IsNullOrEmpty(Identifier))
{
    <div class="cb-identity">
        <Avatar ImageUrl="@ImageUrl" Name="@Identifier" Size="20" />
        <span class="cb-identity__text">@Identifier</span>
        @if (OnEdit.HasDelegate)
        {
            <button type="button" class="cb-icon-btn cb-identity__edit" aria-label="@EditLabel" @onclick="OnEdit">
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M11.7 1.3a1 1 0 0 1 1.4 0l1.6 1.6a1 1 0 0 1 0 1.4L5.4 13.6 2 14l.4-3.4 9.3-9.3Z"/></svg>
            </button>
        }
    </div>
}

@code {
    [Parameter] public string? Identifier { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string EditLabel { get; set; } = "Edit";
    [Parameter] public EventCallback OnEdit { get; set; }
}
