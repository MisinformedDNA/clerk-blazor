@namespace Clerk.Blazor.Internal
<button type="@Type" class="cb-btn cb-btn--@Variant @(Block ? "cb-btn--block" : null) @Class" disabled="@(Disabled || Busy)"
        aria-busy="@(Busy ? "true" : null)" @onclick="OnClick" @attributes="AdditionalAttributes">
    @if (Busy) { <span class="cb-spinner" aria-hidden="true"></span> }
    @ChildContent
</button>

@code {
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string Variant { get; set; } = "primary";
    [Parameter] public bool Block { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
