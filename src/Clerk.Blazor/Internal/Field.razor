@namespace Clerk.Blazor.Internal
@{ var id = Id ?? _autoId; var errId = id + "-error"; var hintId = id + "-hint"; }
<div class="cb-field @(Error is not null ? "cb-field--invalid" : null)">
    <div class="cb-field__labels">
        <label class="cb-field__label" for="@id">@Label</label>
        @if (OptionalText is not null) { <span class="cb-field__optional">@OptionalText</span> }
        @LabelAction
    </div>
    <div class="cb-field__control">
        <input id="@id" class="cb-input" type="@(Type == "password" && _reveal ? "text" : Type)" name="@Name"
               value="@Value" @oninput="OnInput" autocomplete="@Autocomplete" required="@Required" disabled="@Disabled"
               placeholder="@Placeholder" inputmode="@InputMode" autofocus="@AutoFocus" maxlength="@MaxLength"
               aria-invalid="@(Error is not null ? "true" : null)"
               aria-describedby="@(Error is not null ? errId : Hint is not null ? hintId : null)" />
        @if (Type == "password")
        {
            <button type="button" class="cb-field__reveal" aria-pressed="@(_reveal ? "true" : "false")"
                    aria-label="@(_reveal ? HideLabel : ShowLabel)" @onclick="() => _reveal = !_reveal">
                <svg viewBox="0 0 20 20" aria-hidden="true" width="16" height="16"><path fill="currentColor" d="M10 4C5.5 4 2.3 7.1 1 10c1.3 2.9 4.5 6 9 6s7.7-3.1 9-6c-1.3-2.9-4.5-6-9-6Zm0 10a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-6a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z"/>@if (_reveal) {<path stroke="currentColor" stroke-width="1.6" d="M3 3l14 14"/>}</svg>
            </button>
        }
    </div>
    @if (Error is not null)
    {
        <p id="@errId" class="cb-field__error" role="alert">@Error</p>
    }
    else if (Hint is not null)
    {
        <p id="@hintId" class="cb-field__hint">@Hint</p>
    }
</div>

@code {
    private readonly string _autoId = "cb-" + Guid.NewGuid().ToString("N")[..8];
    private bool _reveal;

    [Parameter] public string? Id { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Autocomplete { get; set; }
    [Parameter] public string? InputMode { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AutoFocus { get; set; }
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? OptionalText { get; set; }
    [Parameter] public RenderFragment? LabelAction { get; set; }
    [Parameter] public string ShowLabel { get; set; } = "Show password";
    [Parameter] public string HideLabel { get; set; } = "Hide password";

    private Task OnInput(ChangeEventArgs e) { Value = e.Value?.ToString(); return ValueChanged.InvokeAsync(Value); }
}
