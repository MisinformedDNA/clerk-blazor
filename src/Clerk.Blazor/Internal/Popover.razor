@namespace Clerk.Blazor.Internal
@implements IAsyncDisposable
@inject ClerkService Clerk

<div class="cb-popover @Class" @ref="_root">
    @Trigger
    @if (Open)
    {
        <div class="cb-popover__panel cb-popover__panel--@Align" role="@Role" aria-label="@AriaLabel">
            @ChildContent
        </div>
    }
</div>

@code {
    private ElementReference _root;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<Popover>? _ref;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public RenderFragment? Trigger { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Align { get; set; } = "end";
    [Parameter] public string Role { get; set; } = "dialog";
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open && _handle is null)
        {
            _ref ??= DotNetObjectReference.Create(this);
            var module = await Clerk.BridgeModuleAsync();
            _handle = await module.InvokeAsync<IJSObjectReference>("onOutsideClick", _root, _ref);
            await module.InvokeVoidAsync("focusFirst", _root, ".cb-popover__panel");
        }
        else if (!Open && _handle is not null)
        {
            await ReleaseAsync();
        }
    }

    [JSInvokable]
    public async Task OnOutsideClick()
    {
        await ReleaseAsync();
        Open = false;
        await OpenChanged.InvokeAsync(false);
        StateHasChanged();
    }

    private async Task ReleaseAsync()
    {
        if (_handle is null) return;
        var h = _handle;
        _handle = null;
        try { await h.InvokeVoidAsync("release"); await h.DisposeAsync(); } catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        await ReleaseAsync();
        _ref?.Dispose();
    }
}
