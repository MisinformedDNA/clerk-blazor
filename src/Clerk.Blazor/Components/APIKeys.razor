@namespace Clerk.Blazor.Components
@inherits ClerkComponentBase
@using Clerk.Blazor.Internal

@* Native API keys manager (<APIKeys />): search, create, reveal-once secret, revoke. *@
<div class="@RootClass("cb-apikeys")" style="@RootStyle" data-cb-theme="@ThemeAttr" @attributes="AdditionalAttributes">
    @if (!Auth.IsSignedIn)
    {
        <Alert Kind="info" Message="@L.BillingSignedInRequired" />
    }
    else
    {
        <div class="cb-toolbar">
            <label class="cb-visually-hidden" for="@($"{_uid}-search")">@L.ApiKeysSearch</label>
            <input id="@($"{_uid}-search")" class="cb-input" type="search" placeholder="@L.Search" value="@_query" @oninput="OnSearchInput" />
            @if (!_creating && _secret is null)
            {
                <Btn OnClick="StartCreate">@L.AddApiKey</Btn>
            }
        </div>

        @if (_secret is not null)
        {
            <div class="cb-panel" role="region" aria-labelledby="@($"{_uid}-secret")">
                <h3 class="cb-panel__title" id="@($"{_uid}-secret")">@L.ApiKeysSecretLabel</h3>
                <Alert Kind="warning" Message="@L.ApiKeySecretHint" />
                <div class="cb-secret">
                    <code class="cb-mono">@_secret</code>
                    <Btn Variant="outline" OnClick="CopyAsync">@(_copied ? L.Copied : L.Copy)</Btn>
                </div>
                <span class="cb-visually-hidden" role="status" aria-live="polite">@(_copied ? L.Copied : null)</span>
                <div class="cb-actions">
                    <Btn OnClick="DismissSecret">@L.ApiKeysDone</Btn>
                </div>
            </div>
        }
        else if (_creating)
        {
            <form class="cb-panel cb-form" @onsubmit="CreateAsync" @onsubmit:preventDefault aria-labelledby="@($"{_uid}-create")">
                <h3 class="cb-panel__title" id="@($"{_uid}-create")">@L.AddApiKey</h3>
                <Alert Message="@GlobalError()" />
                <Field Label="@L.ApiKeyName" @bind-Value="_name" Required AutoFocus Placeholder="@L.ApiKeysNamePlaceholder" MaxLength="100" Error="@FieldError("name")" />
                @if (ShowDescription)
                {
                    <div class="cb-field">
                        <div class="cb-field__labels">
                            <label class="cb-field__label" for="@($"{_uid}-desc")">@L.ApiKeyDescription</label>
                            <span class="cb-field__optional">@L.Optional</span>
                        </div>
                        <textarea id="@($"{_uid}-desc")" class="cb-textarea" rows="3" @bind="_description"></textarea>
                    </div>
                }
                <div class="cb-field">
                    <label class="cb-field__label" for="@($"{_uid}-exp")">@L.Expiration</label>
                    <select id="@($"{_uid}-exp")" class="cb-select" @bind="_expiration">
                        @foreach (var (seconds, label) in ExpirationOptions)
                        {
                            <option value="@seconds">@label</option>
                        }
                    </select>
                </div>
                <div class="cb-actions">
                    <Btn Variant="ghost" Disabled="Busy" OnClick="() => _creating = false">@L.Cancel</Btn>
                    <Btn Type="submit" Busy="Busy" Disabled="@string.IsNullOrWhiteSpace(_name)">@L.ApiKeysCreate</Btn>
                </div>
            </form>
        }

        @if (!_creating) { <Alert Message="@GlobalError()" /> }

        @if (_keys is null)
        {
            <div class="cb-center" role="status"><span class="cb-spinner cb-spinner--lg" aria-hidden="true"></span><span class="cb-visually-hidden">@L.Loading</span></div>
        }
        else if (_keys.Data.Count == 0)
        {
            <p class="cb-empty">@(string.IsNullOrEmpty(_query) ? L.ApiKeysEmpty : L.ApiKeysNoMatches)</p>
        }
        else
        {
            <div class="cb-table-wrap">
                <table class="cb-table">
                    <caption class="cb-visually-hidden">@L.ApiKeysTitle</caption>
                    <thead>
                        <tr>
                            <th scope="col">@L.ApiKeyName</th>
                            <th scope="col">@L.LastUsed</th>
                            <th scope="col">@L.ApiKeysExpires</th>
                            <th scope="col">@L.Created</th>
                            <th scope="col"><span class="cb-visually-hidden">@L.BillingActions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var key in _keys.Data)
                        {
                            <tr>
                                <td>
                                    <div class="cb-stack cb-stack--sm">
                                        <div class="cb-inline">
                                            <strong>@key.Name</strong>
                                            @if (key.Revoked) { <span class="cb-badge cb-badge--danger">@L.ApiKeysRevoked</span> }
                                            else if (key.Expired) { <span class="cb-badge cb-badge--warning">@L.ApiKeysExpired</span> }
                                        </div>
                                        @if (ShowDescription && !string.IsNullOrEmpty(key.Description)) { <span class="cb-muted">@key.Description</span> }
                                    </div>
                                </td>
                                <td>@(key.LastUsedAt is null ? L.ApiKeysNeverUsed : BillingFormat.Date(key.LastUsedAt))</td>
                                <td>@(key.Expiration is null ? L.Never : BillingFormat.Date(key.Expiration))</td>
                                <td>@BillingFormat.Date(key.CreatedAt)</td>
                                <td class="cb-num">
                                    @if (!key.Revoked)
                                    {
                                        <Btn Variant="danger-outline" aria-label="@($"{L.Revoke} {key.Name}")" OnClick="() => OpenRevoke(key)">@L.Revoke</Btn>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="_page" PageSize="PerPage" TotalCount="_keys.TotalCount" PageChanged="LoadAsync" PreviousText="@L.Previous" NextText="@L.Next" />
        }
    }
</div>
<Modal Open="_revoke is not null" OpenChanged="OnRevokeOpenChanged" Title="@L.RevokeKey" CloseLabel="@L.Close">
    @if (_revoke is not null)
    {
        <form class="cb-form" @onsubmit="RevokeAsync" @onsubmit:preventDefault>
            <p class="cb-text">@Format(L.ApiKeysRevokeWarning, _revoke.Name)</p>
            <Alert Message="@_revokeError" />
            <Field Label="@Format(L.TypeToConfirm, L.Revoke)" @bind-Value="_revokeConfirm" AutoFocus Autocomplete="off" />
            <div class="cb-actions">
                <Btn Variant="ghost" Disabled="Busy" OnClick="() => _revoke = null">@L.Cancel</Btn>
                <Btn Type="submit" Variant="danger" Busy="Busy" Disabled="@(_revokeConfirm != L.Revoke)">@L.RevokeKey</Btn>
            </div>
        </form>
    }
</Modal>

@code {
    private readonly string _uid = "cb-ak-" + Guid.NewGuid().ToString("N")[..8];
    private ClerkPage<ClerkApiKey>? _keys;
    private int _page = 1;
    private string _query = "";
    private CancellationTokenSource? _debounce;
    private string? _authKey;

    private bool _creating;
    private string _name = "";
    private string? _description;
    private string _expiration = "";
    private string? _secret;
    private bool _copied;

    private ClerkApiKey? _revoke;
    private string _revokeConfirm = "";
    private string? _revokeError;

    /// <summary>The user or organization id that owns the keys. Defaults to the active organization (when organization API keys are enabled) or the user.</summary>
    [Parameter] public string? Subject { get; set; }
    [Parameter] public int PerPage { get; set; } = 10;
    [Parameter] public bool ShowDescription { get; set; }

    private string? EffectiveSubject => Subject
        ?? (Env.ApiKeys is { OrganizationEnabled: true } && Auth.OrgId is not null ? Auth.OrgId : Auth.UserId);

    private string AuthKey => $"{Auth.UserId}|{EffectiveSubject}";

    private IEnumerable<(string Seconds, string Label)> ExpirationOptions =>
    [
        ("", L.Never),
        ((86400).ToString(), L.ApiKeysOneDay),
        ((7 * 86400).ToString(), Format(L.ApiKeysDays, 7)),
        ((30 * 86400).ToString(), Format(L.ApiKeysDays, 30)),
        ((60 * 86400).ToString(), Format(L.ApiKeysDays, 60)),
        ((90 * 86400).ToString(), Format(L.ApiKeysDays, 90)),
        ((180 * 86400).ToString(), Format(L.ApiKeysDays, 180)),
        ((365 * 86400).ToString(), L.ApiKeysOneYear),
    ];

    protected override Task OnInitializedAsync() => ReloadIfAuthChangedAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (_authKey is not null) await ReloadIfAuthChangedAsync();
    }

    protected override void OnClerkStateChanged(ClerkState state)
    {
        _ = ReloadIfAuthChangedAsync();
        StateHasChanged();
    }

    private async Task ReloadIfAuthChangedAsync()
    {
        if (!Auth.IsSignedIn || AuthKey == _authKey) return;
        _authKey = AuthKey;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int page)
    {
        _page = page;
        await RunAsync(async () => _keys = await Clerk.ApiKeys.GetAllAsync(EffectiveSubject, page, PerPage, string.IsNullOrWhiteSpace(_query) ? null : _query.Trim()));
        StateHasChanged();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce?.Dispose();
        var cts = _debounce = new CancellationTokenSource();
        try { await Task.Delay(300, cts.Token); }
        catch (TaskCanceledException) { return; }
        await LoadAsync(1);
    }

    private void StartCreate()
    {
        _creating = true;
        _name = "";
        _description = null;
        _expiration = "";
        Error = null;
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        ClerkApiKey? created = null;
        var seconds = int.TryParse(_expiration, out var s) ? s : (int?)null;
        var ok = await RunAsync(async () => created = await Clerk.ApiKeys.CreateAsync(_name.Trim(), string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(), seconds, EffectiveSubject));
        if (!ok || created is null) return;
        _creating = false;
        _secret = created.Secret;
        _copied = false;
        await LoadAsync(1);
    }

    private async Task CopyAsync()
    {
        if (_secret is null) return;
        var module = await Clerk.BridgeModuleAsync();
        _copied = await module.InvokeAsync<bool>("copyToClipboard", _secret);
    }

    private void DismissSecret()
    {
        _secret = null;
        _copied = false;
    }

    private void OpenRevoke(ClerkApiKey key)
    {
        _revoke = key;
        _revokeConfirm = "";
        _revokeError = null;
    }

    private void OnRevokeOpenChanged(bool open)
    {
        if (!open) _revoke = null;
    }

    private async Task RevokeAsync()
    {
        if (_revoke is null || _revokeConfirm != L.Revoke) return;
        var key = _revoke;
        var ok = await RunAsync(() => Clerk.ApiKeys.RevokeAsync(key.Id));
        if (!ok)
        {
            _revokeError = GlobalError();
            Error = null;
            return;
        }
        _revoke = null;
        await LoadAsync(_page);
    }

    public override void Dispose()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
        base.Dispose();
    }
}
