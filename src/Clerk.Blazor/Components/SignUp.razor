@namespace Clerk.Blazor.Components
@inherits ClerkAuthFlowBase
@using Clerk.Blazor.Internal

@*
    Native sign-up flow (<SignUp />). Renders fields from the instance configuration, verifies email/phone
    by code or link, completes missing requirements after OAuth, honors restricted/waitlist modes,
    invitation tickets, legal consent and bot protection (Turnstile renders into #clerk-captcha).
*@
<Card Title="@Title" Subtitle="@Subtitle" Class="@($"cb-sign-up {Class}")" AdditionalAttributes="AdditionalAttributes" Footer="@FooterContent">
    @if (!State.IsLoaded || _step == Step.Loading)
    {
        <div class="cb-center" role="status"><span class="cb-spinner cb-spinner--lg" aria-hidden="true"></span><span class="cb-visually-hidden">@L.Loading</span></div>
    }
    else
    {
        @switch (_step)
        {
            case Step.Restricted:
                <Alert Kind="info" Message="@(Env.SignUpMode == "waitlist" ? L.WaitlistSignUp : L.RestrictedSignUp)" />
                @if (Env.SignUpMode == "waitlist")
                {
                    <a class="cb-btn cb-btn--primary cb-btn--block" href="@Clerk.Options.WaitlistUrl.TrimStart('/')">@L.WaitlistButton</a>
                }
                break;

            case Step.Start:
            case Step.Continue:
                @if (_step == Step.Start)
                {
                    <SocialButtons Providers="Env.SocialProviders" ContinueWith="@L.ContinueWith" Disabled="@(Busy || NeedsLegal)" OnSelect="OAuthAsync" />
                    @if (Web3.Count > 0)
                    {
                        <div class="cb-stack cb-stack--sm">
                            @foreach (var (strategy, name) in Web3)
                            {
                                <Btn Variant="outline" Block Disabled="@(Busy || NeedsLegal)" OnClick="() => Web3Async(strategy)">@Format(L.ContinueWith, name)</Btn>
                            }
                        </div>
                    }
                    @if (Env.SocialProviders.Count > 0 || Web3.Count > 0) { <Divider Text="@L.Or" /> }
                }
                <form class="cb-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault novalidate>
                    @if (Show("first_name") || Show("last_name"))
                    {
                        <div class="cb-row">
                            @if (Show("first_name"))
                            {
                                <Field Label="@L.FirstName" @bind-Value="_f.FirstName" Autocomplete="given-name" Required="@Req("first_name")"
                                       OptionalText="@Opt("first_name")" Error="@FieldError("first_name")" />
                            }
                            @if (Show("last_name"))
                            {
                                <Field Label="@L.LastName" @bind-Value="_f.LastName" Autocomplete="family-name" Required="@Req("last_name")"
                                       OptionalText="@Opt("last_name")" Error="@FieldError("last_name")" />
                            }
                        </div>
                    }
                    @if (Show("username"))
                    {
                        <Field Label="@L.Username" @bind-Value="_f.Username" Autocomplete="username" Required="@Req("username")"
                               OptionalText="@Opt("username")" Error="@FieldError("username")" />
                    }
                    @if (Show("email_address"))
                    {
                        <Field Label="@L.EmailAddress" Type="email" @bind-Value="_f.EmailAddress" Autocomplete="email" Required="@Req("email_address")"
                               OptionalText="@Opt("email_address")" Error="@FieldError("email_address")" Disabled="@_ticketEmail" />
                    }
                    @if (Show("phone_number"))
                    {
                        <Field Label="@L.PhoneNumber" Type="tel" @bind-Value="_f.PhoneNumber" Autocomplete="tel" Placeholder="+1 555 555 0100"
                               Required="@Req("phone_number")" OptionalText="@Opt("phone_number")" Error="@FieldError("phone_number")" />
                    }
                    @if (Show("password"))
                    {
                        <Field Label="@L.Password" Type="password" @bind-Value="_f.Password" Autocomplete="new-password" Required
                               Hint="@($"{Env.PasswordMinLength}+ characters")" Error="@FieldError("password")"
                               ShowLabel="@L.ShowPassword" HideLabel="@L.HidePassword" />
                    }
                    @if (Env.LegalConsentEnabled && (_step == Step.Start || Missing("legal_accepted")))
                    {
                        <label class="cb-check">
                            <input type="checkbox" @bind="_legal" required />
                            <span>
                                @if (Env.TermsUrl is not null || Env.PrivacyPolicyUrl is not null)
                                {
                                    <text>I agree to the </text>
                                    @if (Env.TermsUrl is not null) { <a class="cb-link" href="@Env.TermsUrl" target="_blank" rel="noopener">Terms of Service</a> }
                                    @if (Env.TermsUrl is not null && Env.PrivacyPolicyUrl is not null) { <text> and </text> }
                                    @if (Env.PrivacyPolicyUrl is not null) { <a class="cb-link" href="@Env.PrivacyPolicyUrl" target="_blank" rel="noopener">Privacy Policy</a> }
                                }
                                else { @L.LegalAccept }
                            </span>
                        </label>
                    }
                    <div id="clerk-captcha" class="cb-captcha"></div>
                    <Alert Message="@GlobalError(ShownFields)" />
                    <Btn Type="submit" Block Busy="Busy" Disabled="NeedsLegal">@(_step == Step.Start ? L.SignUpButton : L.Continue)</Btn>
                </form>
                break;

            case Step.VerifyEmail:
            case Step.VerifyPhone:
                <IdentityPreview Identifier="@(_step == Step.VerifyEmail ? _attempt?.EmailAddress : _attempt?.PhoneNumber)" OnEdit="Restart" />
                @if (_emailLink)
                {
                    <p class="cb-text" role="status">@Format(L.EmailLinkSentTo, _attempt?.EmailAddress)</p>
                    <Alert Message="@GlobalError()" />
                    <div class="cb-center"><ResendButton Text="@L.Resend" OnResend="StartEmailLinkAsync" /></div>
                }
                else
                {
                    <form class="cb-form" @onsubmit="VerifyAsync" @onsubmit:preventDefault novalidate>
                        <Field Label="@L.Code" Value="@_code" ValueChanged="CodeChangedAsync" Autocomplete="one-time-code" InputMode="numeric" MaxLength="6"
                               Required AutoFocus Error="@FieldError("code")" />
                        <Alert Message="@GlobalError("code")" />
                        <Btn Type="submit" Block Busy="Busy">@L.Verify</Btn>
                    </form>
                    <div class="cb-center"><ResendButton Text="@L.Resend" Busy="Busy" OnResend="ResendAsync" /></div>
                }
                break;

            case Step.Verifying:
                @if (Error is null)
                {
                    <div class="cb-center" role="status"><span class="cb-spinner cb-spinner--lg" aria-hidden="true"></span><span class="cb-visually-hidden">@L.Loading</span></div>
                }
                else
                {
                    <Alert Message="@(GlobalError() ?? Error.Message)" />
                    <Btn Variant="outline" Block OnClick="Restart">@L.Back</Btn>
                }
                break;
        }
    }
</Card>

@code {
    private enum Step { Loading, Start, Continue, VerifyEmail, VerifyPhone, Restricted, Verifying }

    private sealed class Form
    {
        public string? FirstName, LastName, Username, EmailAddress, PhoneNumber, Password;
    }

    private Step _step = Step.Loading;
    private readonly Form _f = new();
    private ClerkSignUpAttempt? _attempt;
    private string? _code;
    private bool _legal, _emailLink, _ticketEmail;
    private string? _ticket;
    private CancellationTokenSource? _emailLinkCts;

    /// <summary>Custom data stored on the user at sign-up (<c>unsafeMetadata</c>).</summary>
    [Parameter] public object? UnsafeMetadata { get; set; }
    [Parameter] public string? InitialEmailAddress { get; set; }
    [Parameter] public string? InitialPhoneNumber { get; set; }
    [Parameter] public string? InitialUsername { get; set; }
    [Parameter] public string? InitialFirstName { get; set; }
    [Parameter] public string? InitialLastName { get; set; }
    [Parameter] public string? SignInUrl { get; set; }
    [Parameter] public string? SsoCallbackUrl { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override string? OptionsForceRedirect => Clerk.Options.SignUpForceRedirectUrl;
    protected override string OptionsFallbackRedirect => Clerk.Options.SignUpFallbackRedirectUrl;

    private string SignUpBase => Clerk.Options.SignUpUrl.TrimEnd('/');

    private bool NeedsLegal => Env.LegalConsentEnabled && !_legal && (_step == Step.Start || Missing("legal_accepted"));

    private string Title => _step switch
    {
        Step.VerifyEmail => L.CheckEmail,
        Step.VerifyPhone => L.CheckPhone,
        Step.Continue => L.MissingRequirements,
        _ => L.SignUpTitle,
    };

    private string? Subtitle => _step switch
    {
        Step.Start => Format(L.SignUpSubtitle, Env.ApplicationName),
        Step.VerifyEmail when !_emailLink => Format(L.CodeSentTo, _attempt?.EmailAddress),
        Step.VerifyPhone => Format(L.CodeSentTo, _attempt?.PhoneNumber),
        _ => null,
    };

    private RenderFragment? FooterContent => _step is Step.Start or Step.Restricted ? @<text>
        <p class="cb-footer-text">
            @L.HaveAccount
            <a class="cb-link" href="@SignInHref">@L.SignInLink</a>
        </p>
        @ChildContent
    </text> : ChildContent;

    private string SignInHref
    {
        get
        {
            var url = (SignInUrl ?? Clerk.Options.SignInUrl).TrimStart('/');
            var redirect = QueryParam("redirect_url");
            return redirect is null ? url : $"{url}?redirect_url={Uri.EscapeDataString(redirect)}";
        }
    }

    private List<(string Strategy, string Name)> Web3 => Env.Web3Strategies.Where(s => s != "web3_solana_signature").Select(s => (s, s switch
    {
        "web3_metamask_signature" => "MetaMask",
        "web3_okx_wallet_signature" => "OKX Wallet",
        _ => s,
    })).ToList();

    private bool Missing(string field) => _attempt?.MissingFields.Contains(field) == true;

    private bool Show(string attr)
    {
        if (_step == Step.Continue) return Missing(attr);
        return Env.Attribute(attr).Enabled;
    }

    private bool Req(string attr) => _step == Step.Continue || Env.Attribute(attr).Required;
    private string? Opt(string attr) => Req(attr) ? null : L.Optional;

    private string[] ShownFields => new[] { "first_name", "last_name", "username", "email_address", "phone_number", "password" }.Where(Show).ToArray();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _f.EmailAddress = InitialEmailAddress;
        _f.PhoneNumber = InitialPhoneNumber;
        _f.Username = InitialUsername;
        _f.FirstName = InitialFirstName;
        _f.LastName = InitialLastName;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await Clerk.LoadAsync(); } catch { return; }

        var sub = SubPath(Clerk.Options.SignUpUrl);
        if (sub is "sso-callback")
        {
            _step = Step.Verifying;
            StateHasChanged();
            await RunAsync(() => Clerk.HandleRedirectCallbackAsync(new RedirectCallbackOptions
            {
                SignUpFallbackRedirectUrl = FallbackRedirectUrl, SignUpForceRedirectUrl = ForceRedirectUrl,
            }));
            return;
        }
        if (sub is "verify")
        {
            _step = Step.Verifying;
            StateHasChanged();
            await RunAsync(() => Clerk.HandleEmailLinkVerificationAsync(AfterUrl, AfterUrl));
            return;
        }

        _ticket = QueryParam("__clerk_ticket");
        if (_ticket is { Length: > 0 })
        {
            _step = Step.Verifying;
            StateHasChanged();
            if (!await RunAsync(async () => await ApplyAsync(await Clerk.SignUp.CreateAsync(new SignUpFields { Strategy = "ticket", Ticket = _ticket, UnsafeMetadata = UnsafeMetadata }))))
                _step = Step.Start;
            StateHasChanged();
            return;
        }

        if (Auth.IsSignedIn && Env.SingleSessionMode && Routing == ClerkRouting.Path)
        {
            Go(AfterUrl);
            return;
        }

        if (Env.SignUpMode is "restricted" or "waitlist")
        {
            _step = Step.Restricted;
            StateHasChanged();
            return;
        }

        _step = Step.Start;
        if (sub is not null)
        {
            var current = await Clerk.SignUp.GetCurrentAsync();
            if (current.Status == "missing_requirements") await RunAsync(() => ApplyAsync(current));
        }
        StateHasChanged();
    }

    private void Restart()
    {
        _emailLinkCts?.Cancel();
        _attempt = null;
        _code = null;
        Error = null;
        _step = Env.SignUpMode is "restricted" or "waitlist" && _ticket is null ? Step.Restricted : Step.Start;
    }

    private SignUpFields Fields() => new()
    {
        FirstName = Blank(_f.FirstName), LastName = Blank(_f.LastName), Username = Blank(_f.Username),
        EmailAddress = _ticketEmail ? null : Blank(_f.EmailAddress), PhoneNumber = Blank(_f.PhoneNumber), Password = Blank(_f.Password),
        LegalAccepted = Env.LegalConsentEnabled ? _legal : null,
        UnsafeMetadata = _attempt is null ? UnsafeMetadata : null,
    };

    private static string? Blank(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private Task SubmitAsync() => RunAsync(async () =>
    {
        var result = _attempt is null || _step == Step.Start && _attempt.Status != "missing_requirements"
            ? await Clerk.SignUp.CreateAsync(Fields())
            : await Clerk.SignUp.UpdateAsync(Fields());
        await ApplyAsync(result);
    });

    private async Task ApplyAsync(ClerkSignUpAttempt attempt)
    {
        _attempt = attempt;
        _code = null;
        if (attempt.EmailAddress is not null && _ticket is not null) { _ticketEmail = true; _f.EmailAddress = attempt.EmailAddress; }
        switch (attempt.Status)
        {
            case "complete":
                await CompleteAsync(attempt.CreatedSessionId);
                return;
            case "missing_requirements":
                if (attempt.UnverifiedFields.Contains("email_address") && attempt.EmailAddress is not null)
                {
                    _step = Step.VerifyEmail;
                    var verifications = Env.Attribute("email_address").Verifications;
                    _emailLink = !verifications.Contains("email_code") && verifications.Contains("email_link");
                    if (_emailLink) _ = StartEmailLinkAsync();
                    else await Clerk.SignUp.PrepareEmailVerificationAsync();
                }
                else if (attempt.UnverifiedFields.Contains("phone_number") && attempt.PhoneNumber is not null)
                {
                    _step = Step.VerifyPhone;
                    await Clerk.SignUp.PreparePhoneVerificationAsync();
                }
                else
                {
                    _step = Step.Continue;
                }
                return;
            default:
                Restart();
                return;
        }
    }

    private async Task StartEmailLinkAsync()
    {
        _emailLinkCts?.Cancel();
        var cts = _emailLinkCts = new CancellationTokenSource();
        try
        {
            var result = await Clerk.SignUp.SignUpWithEmailLinkAsync(Absolute($"{SignUpBase}/verify"));
            if (!cts.IsCancellationRequested) await ApplyAsync(result);
        }
        catch (ClerkException ex)
        {
            if (!cts.IsCancellationRequested) Error = ex;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CodeChangedAsync(string value)
    {
        _code = value;
        if (value.Length == 6 && value.All(char.IsDigit)) await VerifyAsync();
    }

    private Task VerifyAsync() => RunAsync(async () =>
    {
        var code = _code?.Trim() ?? "";
        var result = _step == Step.VerifyEmail
            ? await Clerk.SignUp.AttemptEmailVerificationAsync(code)
            : await Clerk.SignUp.AttemptPhoneVerificationAsync(code);
        await ApplyAsync(result);
    });

    private Task ResendAsync() => RunAsync(async () =>
    {
        if (_step == Step.VerifyEmail) await Clerk.SignUp.PrepareEmailVerificationAsync();
        else await Clerk.SignUp.PreparePhoneVerificationAsync();
    });

    private Task OAuthAsync(string strategy) => RunAsync(() =>
        Clerk.SignUp.AuthenticateWithRedirectAsync(strategy, Absolute(SsoCallbackUrl ?? $"{SignUpBase}/sso-callback"), Absolute(AfterUrl),
            Env.LegalConsentEnabled ? _legal : null, UnsafeMetadata));

    private Task Web3Async(string strategy) => RunAsync(() => Clerk.SignIn.AuthenticateWithWeb3Async(strategy, AfterUrl));

    public override void Dispose()
    {
        _emailLinkCts?.Cancel();
        base.Dispose();
    }
}
