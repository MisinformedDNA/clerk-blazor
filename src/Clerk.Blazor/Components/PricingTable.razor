@namespace Clerk.Blazor.Components
@inherits ClerkComponentBase
@using Clerk.Blazor.Internal

@* Native pricing table (<PricingTable />): plans, billing period toggle and checkout. *@
<div class="@RootClass("cb-pricing")" style="@RootStyle" data-cb-theme="@ThemeAttr" @attributes="AdditionalAttributes">
    @if (_plans is null)
    {
        @if (_loadError is null)
        {
            <div class="cb-center" role="status"><span class="cb-spinner cb-spinner--lg" aria-hidden="true"></span><span class="cb-visually-hidden">@L.Loading</span></div>
        }
        else
        {
            <Alert Message="@_loadError" />
        }
    }
    else if (_plans.Count == 0)
    {
        <p class="cb-empty">@L.BillingNoPlans</p>
    }
    else
    {
        @if (NeedsOrganization)
        {
            <Alert Kind="info" Message="@L.BillingNoOrganization" />
        }
        @if (_plans.Any(BillingFormat.HasAnnual))
        {
            <div class="cb-pricing__toggle" role="group" aria-label="@L.BillingPeriodLabel">
                <button type="button" aria-pressed="@(_period == "month" ? "true" : "false")" @onclick="@(() => _period = "month")">@L.Monthly</button>
                <button type="button" aria-pressed="@(_period == "annual" ? "true" : "false")" @onclick="@(() => _period = "annual")">@L.Annually</button>
            </div>
        }
        <div class="cb-pricing__grid">
            @foreach (var plan in _plans)
            {
                var item = ItemFor(plan);
                var active = item is { Status: "active" or "past_due" };
                var period = PeriodFor(plan);
                var featuresId = "cb-feat-" + plan.Id;
                var showFeatures = !CollapseFeatures || _expanded.Contains(plan.Id);
                <article class="cb-plan @(active ? "cb-plan--active" : null)" aria-label="@plan.Name">
                    <header class="cb-plan__head">
                        @if (!string.IsNullOrEmpty(plan.AvatarUrl)) { <Avatar ImageUrl="@plan.AvatarUrl" Name="@plan.Name" Shape="square" Size="40" /> }
                        <div class="cb-plan__title">
                            <div class="cb-inline">
                                <h3 class="cb-plan__name">@plan.Name</h3>
                                @if (active) { <span class="cb-badge cb-badge--success">@L.BillingStatusActive</span> }
                                else if (item is { Status: "upcoming" }) { <span class="cb-badge cb-badge--primary">@L.BillingStatusUpcoming</span> }
                            </div>
                            @if (!string.IsNullOrEmpty(plan.Description)) { <p class="cb-plan__desc">@plan.Description</p> }
                        </div>
                    </header>
                    <div class="cb-plan__price">
                        @if (plan.IsFree)
                        {
                            <span class="cb-plan__amount">@L.Free</span>
                        }
                        else
                        {
                            <span class="cb-plan__amount">@BillingFormat.Money(period == "annual" ? plan.AnnualMonthlyFee ?? plan.Fee : plan.Fee)</span>
                            <span class="cb-plan__period">@L.PerMonth</span>
                            @if (period == "annual") { <span class="cb-plan__period cb-plan__note">@L.BilledAnnually</span> }
                        }
                    </div>
                    @if (CtaPosition == "top") { @Cta(plan, item) }
                    @if (plan.Features.Count > 0)
                    {
                        @if (CollapseFeatures)
                        {
                            <button type="button" class="cb-link cb-link--sm cb-plan__toggle" aria-expanded="@(showFeatures ? "true" : "false")" aria-controls="@featuresId"
                                    @onclick="() => ToggleFeatures(plan.Id)">@(showFeatures ? L.BillingHideFeatures : L.BillingShowFeatures)</button>
                        }
                        @if (showFeatures)
                        {
                            <ul class="cb-plan__features" id="@featuresId" aria-label="@L.Features">
                                @foreach (var f in plan.Features)
                                {
                                    <li>
                                        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                        <span>@f.Name</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="cb-plan__spacer"></div>
                        }
                    }
                    else
                    {
                        <div class="cb-plan__spacer"></div>
                    }
                    @if (CtaPosition != "top") { @Cta(plan, item) }
                </article>
            }
        </div>
    }
</div>
<CheckoutDrawer @bind-Open="_checkoutOpen" PlanId="@_checkoutPlan" PlanPeriod="@_checkoutPeriod" For="@For" Class="@CheckoutProps?.Class"
                NewSubscriptionRedirectUrl="@NewSubscriptionRedirectUrl" OnSubscriptionComplete="OnCheckoutCompleteAsync" />
<SubscriptionDetailsDrawer @bind-Open="_detailsOpen" For="@For" OnSubscriptionCancel="ReloadSubscriptionAsync" OnSubscriptionChange="ReloadSubscriptionAsync" />

@code {
    private List<BillingPlan>? _plans;
    private BillingSubscription? _subscription;
    private string? _loadError;
    private string _period = "month";
    private readonly HashSet<string> _expanded = [];
    private string? _authKey;
    private bool _checkoutOpen;
    private string? _checkoutPlan;
    private string _checkoutPeriod = "month";
    private bool _detailsOpen;

    /// <summary><c>user</c> (default) or <c>organization</c>.</summary>
    [Parameter] public string For { get; set; } = "user";
    /// <summary>Where to go after a successful checkout. When unset the drawer closes.</summary>
    [Parameter] public string? NewSubscriptionRedirectUrl { get; set; }
    /// <summary><c>bottom</c> (default) or <c>top</c>.</summary>
    [Parameter] public string CtaPosition { get; set; } = "bottom";
    /// <summary>Hide feature lists behind a toggle.</summary>
    [Parameter] public bool CollapseFeatures { get; set; }
    [Parameter] public PricingTableCheckoutProps? CheckoutProps { get; set; }
    /// <summary>Raised after a checkout completes.</summary>
    [Parameter] public EventCallback OnSubscriptionComplete { get; set; }

    private bool ForOrganization => BillingFormat.IsOrganization(For);
    private bool NeedsOrganization => ForOrganization && Auth.IsSignedIn && Auth.OrgId is null;
    private string AuthKey => $"{Auth.IsLoaded}|{Auth.UserId}|{(ForOrganization ? Auth.OrgId : null)}";

    private bool HasPaidSubscription => _subscription?.SubscriptionItems.Any(i => i.Plan is { IsFree: false } && i.Status is "active" or "past_due") == true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var page = await Clerk.Billing.GetPlansAsync(BillingFormat.PayerType(For), 1, 50);
            _plans = page.Data.OrderBy(p => p.Fee?.Amount ?? 0).ToList();
        }
        catch (ClerkException ex) { _loadError = ex.Message; }
        catch (JSException ex) { _loadError = ex.Message; }
        await ReloadIfAuthChangedAsync();
    }

    protected override void OnClerkStateChanged(ClerkState state)
    {
        _ = ReloadIfAuthChangedAsync();
        StateHasChanged();
    }

    private async Task ReloadIfAuthChangedAsync()
    {
        var key = AuthKey;
        if (key == _authKey) return;
        _authKey = key;
        await ReloadSubscriptionAsync();
    }

    private async Task ReloadSubscriptionAsync()
    {
        if (!Auth.IsSignedIn || (ForOrganization && Auth.OrgId is null)) { _subscription = null; StateHasChanged(); return; }
        try { _subscription = await Clerk.Billing.GetSubscriptionAsync(ForOrganization ? Auth.OrgId : null); }
        catch (ClerkException) { _subscription = null; }
        catch (JSException) { _subscription = null; }
        StateHasChanged();
    }

    private BillingSubscriptionItem? ItemFor(BillingPlan plan) =>
        _subscription?.SubscriptionItems.FirstOrDefault(i => i.Plan?.Id == plan.Id && i.Status is "active" or "past_due" or "upcoming");

    private string PeriodFor(BillingPlan plan) => _period == "annual" && BillingFormat.HasAnnual(plan) ? "annual" : "month";

    private void ToggleFeatures(string id)
    {
        if (!_expanded.Remove(id)) _expanded.Add(id);
    }

    private RenderFragment Cta(BillingPlan plan, BillingSubscriptionItem? item) => __builder =>
    {
        var (label, variant, disabled, action) = CtaFor(plan, item);
        <Btn Variant="@variant" Block Disabled="@disabled" OnClick="action">@label</Btn>
    };

    private (string Label, string Variant, bool Disabled, Func<Task> Action) CtaFor(BillingPlan plan, BillingSubscriptionItem? item)
    {
        var period = PeriodFor(plan);
        var trial = plan.FreeTrialEnabled && plan.FreeTrialDays is > 0 && (_subscription?.EligibleForFreeTrial ?? true);

        if (!Auth.IsSignedIn)
            return (trial ? Format(L.StartTrial, plan.FreeTrialDays) : L.Subscribe, plan.IsFree ? "outline" : "primary", false, SignInAsync);
        if (NeedsOrganization)
            return (L.Subscribe, "outline", true, () => Task.CompletedTask);

        if (item is not null)
        {
            if (item.CanceledAt is not null && !plan.IsFree)
                return (L.BillingResubscribe, "primary", false, () => CheckoutAsync(plan, item.PlanPeriod));
            if (item.Status == "upcoming")
                return (L.BillingStatusUpcoming, "outline", true, () => Task.CompletedTask);
            if (plan.IsFree)
                return (L.CurrentPlan, "outline", true, () => Task.CompletedTask);
            if (item.PlanPeriod != period)
                return (period == "annual" ? L.BillingSwitchToAnnual : L.BillingSwitchToMonthly, "outline", false, () => CheckoutAsync(plan, period));
            return (L.BillingManage, "outline", false, OpenDetailsAsync);
        }

        if (trial) return (Format(L.StartTrial, plan.FreeTrialDays), "primary", false, () => CheckoutAsync(plan, period));
        if (HasPaidSubscription) return (L.SwitchPlan, "outline", false, () => CheckoutAsync(plan, period));
        return (L.Subscribe, plan.IsFree ? "outline" : "primary", false, () => CheckoutAsync(plan, period));
    }

    private Task SignInAsync()
    {
        Clerk.RedirectToSignIn();
        return Task.CompletedTask;
    }

    private Task OpenDetailsAsync()
    {
        _detailsOpen = true;
        return Task.CompletedTask;
    }

    private Task CheckoutAsync(BillingPlan plan, string period)
    {
        _checkoutPlan = plan.Id;
        _checkoutPeriod = period;
        _checkoutOpen = true;
        return Task.CompletedTask;
    }

    private async Task OnCheckoutCompleteAsync()
    {
        await ReloadSubscriptionAsync();
        await OnSubscriptionComplete.InvokeAsync();
    }
}
