@namespace Clerk.Blazor.Components
@inherits ClerkComponentBase
@using Clerk.Blazor.Internal

@* Opens the subscription details drawer (<SubscriptionDetailsButton />). Signed-out users are sent to sign in. *@
@if (ChildContent is not null)
{
    <span class="cb-trigger" @onclick="OpenAsync" @attributes="AdditionalAttributes">@ChildContent</span>
}
else
{
    <button type="button" class="@RootClass("cb-btn cb-btn--outline")" style="@RootStyle" data-cb-theme="@ThemeAttr" @onclick="OpenAsync" @attributes="AdditionalAttributes">@L.BillingSubscriptionDetails</button>
}
<SubscriptionDetailsDrawer @bind-Open="_open" For="@For" Class="@DrawerClass" OnSubscriptionCancel="OnSubscriptionCancel" />

@code {
    private bool _open;

    /// <summary><c>user</c> (default) or <c>organization</c>. Organization subscriptions use the active organization.</summary>
    [Parameter] public string For { get; set; } = "user";
    [Parameter] public EventCallback OnSubscriptionCancel { get; set; }
    /// <summary>Extra CSS class for the drawer.</summary>
    [Parameter] public string? DrawerClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private void OpenAsync()
    {
        if (!Auth.IsSignedIn) { Clerk.RedirectToSignIn(); return; }
        if (BillingFormat.IsOrganization(For) && Auth.OrgId is null)
            throw new InvalidOperationException("<SubscriptionDetailsButton For=\"organization\"> requires an active organization.");
        _open = true;
    }
}
