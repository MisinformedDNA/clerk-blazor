@namespace Clerk.Blazor.Components
@inherits ClerkComponentBase

@if (ChildContent is not null)
{
    <button type="button" class="cb-trigger cb-trigger--bare" @onclick="OpenAsync" @attributes="AdditionalAttributes">@ChildContent</button>
}
else
{
    <button type="button" class="@RootClass("cb-btn cb-btn--primary")" @onclick="OpenAsync" @attributes="AdditionalAttributes">@L.SignUpButton</button>
}
@if (Mode == ClerkButtonMode.Modal)
{
    <Clerk.Blazor.Internal.Modal @bind-Open="_open" AriaLabel="@L.SignUpTitle" CloseLabel="@L.Close" Class="cb-dialog--auth">
        <SignUp Routing="ClerkRouting.Virtual" FallbackRedirectUrl="@FallbackRedirectUrl" ForceRedirectUrl="@ForceRedirectUrl"
                UnsafeMetadata="@UnsafeMetadata" OnComplete="() => _open = false" />
    </Clerk.Blazor.Internal.Modal>
}

@code {
    private bool _open;

    [Parameter] public ClerkButtonMode Mode { get; set; }
    [Parameter] public string? FallbackRedirectUrl { get; set; }
    [Parameter] public string? ForceRedirectUrl { get; set; }
    [Parameter] public object? UnsafeMetadata { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private void OpenAsync()
    {
        if (Mode == ClerkButtonMode.Modal) { _open = true; return; }
        Go(Clerk.BuildSignUpUrl(ForceRedirectUrl ?? FallbackRedirectUrl));
    }
}
