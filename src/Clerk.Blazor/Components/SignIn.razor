@namespace Clerk.Blazor.Components
@inherits ClerkAuthFlowBase
@using Clerk.Blazor.Internal

@*
    Native sign-in flow (<SignIn />). Supports identifier + password, email/SMS codes, email links,
    passkeys, OAuth/SSO, enterprise SSO, Web3 (MetaMask, OKX, Solana), forgot password, MFA,
    client trust, ticket (invitation) sign-in and path routing (/sign-in/sso-callback, /sign-in/verify).
*@
<Card Title="@Title" Subtitle="@Subtitle" Class="@($"cb-sign-in {Class}")" AdditionalAttributes="AdditionalAttributes" Footer="@FooterContent">
    @if (!State.IsLoaded || _step == Step.Loading)
    {
        <div class="cb-center" role="status"><span class="cb-spinner cb-spinner--lg" aria-hidden="true"></span><span class="cb-visually-hidden">@L.Loading</span></div>
    }
    else
    {
        @switch (_step)
        {
            case Step.Start:
                <SocialButtons Providers="Env.SocialProviders" ContinueWith="@L.ContinueWith" Disabled="Busy" OnSelect="OAuthAsync" />
                @if (Web3.Count > 0)
                {
                    <div class="cb-stack cb-stack--sm">
                        @foreach (var (strategy, name) in Web3)
                        {
                            <Btn Variant="outline" Block Disabled="Busy" OnClick="() => Web3Async(strategy)">@Format(L.ContinueWith, name)</Btn>
                        }
                    </div>
                }
                @if (HasIdentifierField && (Env.SocialProviders.Count > 0 || Web3.Count > 0))
                {
                    <Divider Text="@L.Or" />
                }
                @if (HasIdentifierField)
                {
                    <form class="cb-form" @onsubmit="SubmitIdentifierAsync" @onsubmit:preventDefault novalidate>
                        <Field Label="@IdentifierLabel" Type="@IdentifierType" Name="identifier" @bind-Value="_identifier" Autocomplete="username webauthn"
                               Required AutoFocus Error="@FieldError("identifier")" />
                        <Alert Message="@GlobalError("identifier")" />
                        <Btn Type="submit" Block Busy="Busy">@L.Continue</Btn>
                    </form>
                }
                else
                {
                    <Alert Message="@GlobalError()" />
                }
                @if (Env.Attribute("passkey").Enabled)
                {
                    <button type="button" class="cb-link cb-center" disabled="@Busy" @onclick="PasskeyAsync">@L.UsePasskey</button>
                }
                break;

            case Step.Password:
                <IdentityPreview Identifier="@CurrentIdentifier" ImageUrl="@_attempt?.UserData?.ImageUrl" OnEdit="Restart" />
                <form class="cb-form" @onsubmit="SubmitPasswordAsync" @onsubmit:preventDefault novalidate>
                    <input type="text" name="username" autocomplete="username" value="@CurrentIdentifier" hidden readonly />
                    <Field Label="@L.Password" Type="password" Name="password" @bind-Value="_password" Autocomplete="current-password" Required AutoFocus
                           Error="@FieldError("password")" ShowLabel="@L.ShowPassword" HideLabel="@L.HidePassword">
                        <LabelAction>
                            @if (ResetFactors.Any()) { <button type="button" class="cb-link cb-link--sm" @onclick="ForgotAsync">@L.ForgotPassword</button> }
                        </LabelAction>
                    </Field>
                    <Alert Message="@GlobalError("password")" />
                    <Btn Type="submit" Block Busy="Busy">@L.Continue</Btn>
                </form>
                <AlternativesLink Count="AlternativeFactors.Count()" OnClick="() => _step = Step.Alternatives" Text="@L.UseAnotherMethod" />
                break;

            case Step.Code:
            case Step.ResetCode:
            case Step.SecondFactor:
                <IdentityPreview Identifier="@(_factor?.SafeIdentifier ?? CurrentIdentifier)" ImageUrl="@_attempt?.UserData?.ImageUrl" OnEdit="Restart" />
                <form class="cb-form" @onsubmit="SubmitCodeAsync" @onsubmit:preventDefault novalidate>
                    @if (IsBackupCode)
                    {
                        <Field Label="@L.BackupCodes" Name="code" @bind-Value="_code" Autocomplete="off" Required AutoFocus Error="@FieldError("code")" />
                    }
                    else
                    {
                        <Field Label="@L.Code" Name="code" Value="@_code" ValueChanged="CodeChangedAsync" Autocomplete="one-time-code" InputMode="numeric"
                               MaxLength="6" Required AutoFocus Error="@FieldError("code")" />
                    }
                    <Alert Message="@GlobalError("code")" />
                    <Btn Type="submit" Block Busy="Busy">@L.Continue</Btn>
                </form>
                @if (CodeNeedsResend)
                {
                    <div class="cb-center"><ResendButton Text="@L.Resend" Busy="Busy" OnResend="ResendAsync" /></div>
                }
                @if (_step == Step.SecondFactor)
                {
                    <div class="cb-stack cb-stack--sm cb-center">
                        @foreach (var f in OtherSecondFactors)
                        {
                            <button type="button" class="cb-link" @onclick="() => ChooseSecondFactorAsync(f)">@SecondFactorLabel(f)</button>
                        }
                    </div>
                }
                else if (_step == Step.Code)
                {
                    <AlternativesLink Count="AlternativeFactors.Count()" OnClick="() => _step = Step.Alternatives" Text="@L.UseAnotherMethod" />
                }
                break;

            case Step.EmailLink:
                <IdentityPreview Identifier="@(_factor?.SafeIdentifier ?? CurrentIdentifier)" ImageUrl="@_attempt?.UserData?.ImageUrl" OnEdit="Restart" />
                <p class="cb-text" role="status">@Format(L.EmailLinkSentTo, _factor?.SafeIdentifier ?? CurrentIdentifier)</p>
                <Alert Message="@GlobalError()" />
                <div class="cb-center"><ResendButton Text="@L.Resend" OnResend="() => StartFirstFactorAsync(_factor!)" /></div>
                <AlternativesLink Count="AlternativeFactors.Count()" OnClick="() => _step = Step.Alternatives" Text="@L.UseAnotherMethod" />
                break;

            case Step.Alternatives:
                <SocialButtons Providers="Env.SocialProviders" ContinueWith="@L.ContinueWith" Disabled="Busy" OnSelect="OAuthAsync" />
                <div class="cb-stack cb-stack--sm">
                    @foreach (var f in AlternativeFactors)
                    {
                        <Btn Variant="outline" Block Disabled="Busy" OnClick="() => StartFirstFactorAsync(f)">@FirstFactorLabel(f)</Btn>
                    }
                </div>
                <Alert Message="@GlobalError()" />
                <button type="button" class="cb-link cb-center" @onclick="BackFromAlternatives">@L.Back</button>
                break;

            case Step.ForgotPassword:
                <div class="cb-stack cb-stack--sm">
                    @foreach (var f in ResetFactors)
                    {
                        <Btn Block Busy="Busy" OnClick="() => StartResetAsync(f)">@Format(L.CodeSentTo, f.SafeIdentifier)</Btn>
                    }
                </div>
                <Alert Message="@GlobalError()" />
                <button type="button" class="cb-link cb-center" @onclick="() => _step = Step.Password">@L.Back</button>
                break;

            case Step.NewPassword:
                <form class="cb-form" @onsubmit="SubmitNewPasswordAsync" @onsubmit:preventDefault novalidate>
                    <input type="text" name="username" autocomplete="username" value="@CurrentIdentifier" hidden readonly />
                    <Field Label="@L.NewPassword" Type="password" @bind-Value="_newPassword" Autocomplete="new-password" Required AutoFocus
                           Error="@FieldError("password")" ShowLabel="@L.ShowPassword" HideLabel="@L.HidePassword" />
                    <Field Label="@L.ConfirmPassword" Type="password" @bind-Value="_confirmPassword" Autocomplete="new-password" Required
                           Error="@_mismatch" ShowLabel="@L.ShowPassword" HideLabel="@L.HidePassword" />
                    <label class="cb-check"><input type="checkbox" @bind="_signOutOthers" /> @L.SignOutOtherSessions</label>
                    <Alert Message="@GlobalError("password")" />
                    <Btn Type="submit" Block Busy="Busy">@L.ResetPasswordTitle</Btn>
                </form>
                break;

            case Step.Solana:
                <div class="cb-stack cb-stack--sm">
                    @foreach (var wallet in SolanaWallets)
                    {
                        <Btn Variant="outline" Block Disabled="Busy" OnClick="() => SolanaAsync(wallet)">@wallet</Btn>
                    }
                </div>
                <Alert Message="@GlobalError()" />
                <button type="button" class="cb-link cb-center" @onclick="Restart">@L.Back</button>
                break;

            case Step.Verifying:
                @if (Error is null)
                {
                    <div class="cb-center" role="status"><span class="cb-spinner cb-spinner--lg" aria-hidden="true"></span><span class="cb-visually-hidden">@L.Loading</span></div>
                }
                else
                {
                    <Alert Message="@(GlobalError() ?? Error.Message)" />
                    <Btn Variant="outline" Block OnClick="Restart">@L.Back</Btn>
                }
                break;
        }
        <div id="clerk-captcha" class="cb-captcha"></div>
    }
</Card>

@code {
    private enum Step { Loading, Start, Password, Code, EmailLink, Alternatives, ForgotPassword, ResetCode, NewPassword, SecondFactor, Solana, Verifying }

    private static readonly string[] SolanaWallets = ["Phantom", "Solflare", "Backpack"];

    private Step _step = Step.Loading;
    private ClerkSignInAttempt? _attempt;
    private SignInFactor? _factor;
    private string? _identifier, _password, _code, _newPassword, _confirmPassword, _mismatch;
    private bool _signOutOthers = true;
    private bool _clientTrust;
    private CancellationTokenSource? _emailLinkCts;

    /// <summary>Pre-fills the identifier field.</summary>
    [Parameter] public string? InitialIdentifier { get; set; }
    /// <summary>Overrides the URL OAuth providers return to. Defaults to <c>{SignInUrl}/sso-callback</c>.</summary>
    [Parameter] public string? SsoCallbackUrl { get; set; }
    /// <summary>Allow OAuth sign-ins for unknown accounts to transfer to sign-up. Defaults to <c>true</c>.</summary>
    [Parameter] public bool Transferable { get; set; } = true;
    [Parameter] public string? SignUpUrl { get; set; }
    /// <summary>Content rendered below the card footer link.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override string? OptionsForceRedirect => Clerk.Options.SignInForceRedirectUrl;
    protected override string OptionsFallbackRedirect => Clerk.Options.SignInFallbackRedirectUrl;

    private string SignInBase => Clerk.Options.SignInUrl.TrimEnd('/');

    private string Title => _step switch
    {
        Step.Password => L.EnterPassword,
        Step.Code => _factor?.Strategy == "phone_code" ? L.CheckPhone : L.CheckEmail,
        Step.EmailLink => L.CheckEmail,
        Step.ResetCode => L.ForgotPassword,
        Step.ForgotPassword => L.ForgotPassword,
        Step.NewPassword => L.ResetPasswordTitle,
        Step.SecondFactor => _clientTrust ? L.ClientTrustTitle : L.TwoStepTitle,
        Step.Alternatives => L.UseAnotherMethod,
        _ => L.SignInTitle,
    };

    private string? Subtitle => _step switch
    {
        Step.Start => Format(L.SignInSubtitle, Env.ApplicationName),
        Step.Code or Step.ResetCode => Format(L.CodeSentTo, _factor?.SafeIdentifier ?? CurrentIdentifier),
        Step.SecondFactor => _clientTrust ? L.ClientTrustPrompt : _factor?.Strategy switch
        {
            "totp" => L.TotpPrompt,
            "backup_code" => L.BackupCodePrompt,
            _ => Format(L.CodeSentTo, _factor?.SafeIdentifier),
        },
        _ => null,
    };

    private RenderFragment? FooterContent => _step != Step.Start || Env.SignUpMode == "restricted" ? ChildContent : @<text>
        <p class="cb-footer-text">
            @L.NoAccount
            <a class="cb-link" href="@SignUpHref">@(Env.SignUpMode == "waitlist" ? L.WaitlistButton : L.SignUpLink)</a>
        </p>
        @ChildContent
    </text>;

    private string SignUpHref
    {
        get
        {
            var target = Env.SignUpMode == "waitlist" ? Clerk.Options.WaitlistUrl : SignUpUrl ?? Clerk.Options.SignUpUrl;
            var redirect = QueryParam("redirect_url");
            var url = target.TrimStart('/');
            return redirect is null ? url : $"{url}?redirect_url={Uri.EscapeDataString(redirect)}";
        }
    }

    private bool HasIdentifierField => IdentifierAttributes.Count > 0;

    private List<string> IdentifierAttributes =>
        new[] { "email_address", "username", "phone_number" }.Where(a => Env.Attribute(a) is { Enabled: true, UsedForFirstFactor: true }).ToList();

    private string IdentifierLabel => IdentifierAttributes switch
    {
        ["email_address"] => L.EmailAddress,
        ["phone_number"] => L.PhoneNumber,
        ["username"] => L.Username,
        ["email_address", "username"] => L.EmailOrUsername,
        _ => L.Identifier,
    };

    private string IdentifierType => IdentifierAttributes switch
    {
        ["email_address"] => "email",
        ["phone_number"] => "tel",
        _ => "text",
    };

    private List<(string Strategy, string Name)> Web3 => Env.Web3Strategies.Select(s => (s, s switch
    {
        "web3_metamask_signature" => "MetaMask",
        "web3_okx_wallet_signature" => "OKX Wallet",
        "web3_solana_signature" => "Solana",
        _ => s,
    })).ToList();

    private string? CurrentIdentifier => _attempt?.Identifier ?? _identifier;

    private IEnumerable<SignInFactor> FirstFactors => (_attempt?.SupportedFirstFactors ?? [])
        .Where(f => f.Strategy is "password" or "email_code" or "phone_code" or "email_link" or "passkey");

    private IEnumerable<SignInFactor> ResetFactors => (_attempt?.SupportedFirstFactors ?? [])
        .Where(f => f.Strategy is "reset_password_email_code" or "reset_password_phone_code");

    private IEnumerable<SignInFactor> AlternativeFactors => FirstFactors.Where(f => !SameFactor(f, _factor));

    private IEnumerable<SignInFactor> OtherSecondFactors => (_attempt?.SupportedSecondFactors ?? []).Where(f => !SameFactor(f, _factor));

    private bool IsBackupCode => _factor?.Strategy == "backup_code";
    private bool CodeNeedsResend => _factor?.Strategy is "email_code" or "phone_code" or "reset_password_email_code" or "reset_password_phone_code";

    private static bool SameFactor(SignInFactor a, SignInFactor? b) =>
        b is not null && a.Strategy == b.Strategy && a.EmailAddressId == b.EmailAddressId && a.PhoneNumberId == b.PhoneNumberId;

    private string FirstFactorLabel(SignInFactor f) => f.Strategy switch
    {
        "password" => L.Password,
        "passkey" => L.UsePasskey,
        "email_link" => Format(L.ContinueWith, "email link") + $" ({f.SafeIdentifier})",
        _ => Format(L.CodeSentTo, f.SafeIdentifier).TrimEnd('.'),
    };

    private string SecondFactorLabel(SignInFactor f) => f.Strategy switch
    {
        "totp" => L.UseAuthenticator,
        "backup_code" => L.UseBackupCode,
        "phone_code" => L.UseSmsCode,
        _ => Format(L.CodeSentTo, f.SafeIdentifier).TrimEnd('.'),
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _identifier = InitialIdentifier;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await Clerk.LoadAsync(); } catch { return; }

        var sub = SubPath(Clerk.Options.SignInUrl);
        if (sub is "sso-callback")
        {
            _step = Step.Verifying;
            StateHasChanged();
            await RunAsync(() => Clerk.HandleRedirectCallbackAsync(new RedirectCallbackOptions
            {
                SignInFallbackRedirectUrl = FallbackRedirectUrl, SignInForceRedirectUrl = ForceRedirectUrl, Transferable = Transferable,
            }));
            return;
        }
        if (sub is "verify")
        {
            _step = Step.Verifying;
            StateHasChanged();
            await RunAsync(() => Clerk.HandleEmailLinkVerificationAsync(AfterUrl, AfterUrl));
            return;
        }

        if (QueryParam("__clerk_ticket") is { Length: > 0 } ticket)
        {
            _step = Step.Verifying;
            StateHasChanged();
            if (!await RunAsync(async () => await ApplyAsync(await Clerk.SignIn.CreateAsync(strategy: "ticket", ticket: ticket))))
                _step = Step.Start;
            StateHasChanged();
            return;
        }

        if (Auth.IsSignedIn && Env.SingleSessionMode && Routing == ClerkRouting.Path)
        {
            Go(AfterUrl);
            return;
        }

        _step = Step.Start;
        if (sub is not null)
        {
            // Resume the in-progress attempt (e.g. after an OAuth redirect to /factor-two).
            var current = await Clerk.SignIn.GetCurrentAsync();
            if (current.Status is not null and not "needs_identifier")
                await RunAsync(() => ApplyAsync(current));
        }
        StateHasChanged();
    }

    private void Restart()
    {
        _emailLinkCts?.Cancel();
        _attempt = null;
        _factor = null;
        _password = _code = null;
        _clientTrust = false;
        Error = null;
        _step = Step.Start;
    }

    private void BackFromAlternatives()
    {
        Error = null;
        _step = _factor?.Strategy switch
        {
            "password" => Step.Password,
            "email_link" => Step.EmailLink,
            "email_code" or "phone_code" => Step.Code,
            _ => Step.Start,
        };
    }

    private async Task ApplyAsync(ClerkSignInAttempt attempt)
    {
        _attempt = attempt;
        _code = null;
        switch (attempt.Status)
        {
            case "complete":
                await CompleteAsync(attempt.CreatedSessionId);
                break;
            case "needs_first_factor":
                var sso = attempt.SupportedFirstFactors.FirstOrDefault(f => f.Strategy is "enterprise_sso" or "saml");
                if (sso is not null && !FirstFactors.Any())
                {
                    await Clerk.SignIn.AuthenticateWithRedirectAsync(sso.Strategy, Absolute(SsoCallbackUrl ?? $"{SignInBase}/sso-callback"), Absolute(AfterUrl), attempt.Identifier);
                    break;
                }
                var preferred = PreferredFirstFactor(attempt);
                if (preferred is null) { _step = Step.Alternatives; break; }
                await StartFirstFactorCoreAsync(preferred);
                break;
            case "needs_second_factor":
            case "needs_client_trust":
                _clientTrust = attempt.Status == "needs_client_trust";
                var second = attempt.SupportedSecondFactors.FirstOrDefault(f => f.Default)
                             ?? attempt.SupportedSecondFactors.FirstOrDefault(f => f.Strategy == "totp")
                             ?? attempt.SupportedSecondFactors.FirstOrDefault(f => f.Strategy is "phone_code" or "email_code")
                             ?? attempt.SupportedSecondFactors.FirstOrDefault();
                if (second is not null) await ChooseSecondFactorCoreAsync(second);
                _step = Step.SecondFactor;
                break;
            case "needs_new_password":
                _step = Step.NewPassword;
                break;
            default:
                _step = Step.Start;
                break;
        }
    }

    private SignInFactor? PreferredFirstFactor(ClerkSignInAttempt attempt)
    {
        var factors = FirstFactors.ToList();
        if (Env.PreferredSignInStrategy == "password" && factors.FirstOrDefault(f => f.Strategy == "password") is { } pw) return pw;
        var safe = factors.Where(f => f.SafeIdentifier is not null && string.Equals(f.SafeIdentifier, attempt.Identifier, StringComparison.OrdinalIgnoreCase)).ToList();
        return safe.FirstOrDefault(f => f.Primary && f.Strategy != "passkey") ?? safe.FirstOrDefault(f => f.Strategy != "passkey")
               ?? factors.FirstOrDefault(f => f.Strategy is "email_code" or "phone_code" or "email_link")
               ?? factors.FirstOrDefault();
    }

    private Task SubmitIdentifierAsync() => RunAsync(async () =>
        await ApplyAsync(await Clerk.SignIn.CreateAsync(identifier: _identifier?.Trim())));

    private Task SubmitPasswordAsync() => RunAsync(async () =>
        await ApplyAsync(await Clerk.SignIn.AttemptFirstFactorAsync("password", password: _password)));

    private async Task CodeChangedAsync(string value)
    {
        _code = value;
        if (value.Length == 6 && value.All(char.IsDigit)) await SubmitCodeAsync();
    }

    private Task SubmitCodeAsync() => RunAsync(async () =>
    {
        var code = _code?.Trim() ?? "";
        var result = _step == Step.SecondFactor
            ? await Clerk.SignIn.AttemptSecondFactorAsync(_factor!.Strategy, code)
            : await Clerk.SignIn.AttemptFirstFactorAsync(_factor!.Strategy, code: code);
        await ApplyAsync(result);
    });

    private Task ResendAsync() => RunAsync(async () =>
    {
        if (_step == Step.SecondFactor) await Clerk.SignIn.PrepareSecondFactorAsync(_factor!);
        else await Clerk.SignIn.PrepareFirstFactorAsync(_factor!);
    });

    private Task StartFirstFactorAsync(SignInFactor f) => RunAsync(() => StartFirstFactorCoreAsync(f));

    private async Task StartFirstFactorCoreAsync(SignInFactor f)
    {
        _factor = f;
        switch (f.Strategy)
        {
            case "password":
                _step = Step.Password;
                break;
            case "email_code":
            case "phone_code":
                _attempt = await Clerk.SignIn.PrepareFirstFactorAsync(f);
                _step = Step.Code;
                break;
            case "email_link":
                _step = Step.EmailLink;
                _ = WaitForEmailLinkAsync(f);
                break;
            case "passkey":
                await ApplyAsync(await Clerk.SignIn.AuthenticateWithPasskeyAsync());
                break;
        }
    }

    private async Task WaitForEmailLinkAsync(SignInFactor f)
    {
        _emailLinkCts?.Cancel();
        var cts = _emailLinkCts = new CancellationTokenSource();
        try
        {
            var result = await Clerk.SignIn.SignInWithEmailLinkAsync(f.EmailAddressId!, Absolute($"{SignInBase}/verify"));
            if (cts.IsCancellationRequested) return;
            await ApplyAsync(result);
        }
        catch (ClerkException ex)
        {
            if (!cts.IsCancellationRequested) Error = ex;
        }
        await InvokeAsync(StateHasChanged);
    }

    private Task PasskeyAsync() => RunAsync(async () => await ApplyAsync(await Clerk.SignIn.AuthenticateWithPasskeyAsync("discoverable")));

    private Task OAuthAsync(string strategy) => RunAsync(() =>
        Clerk.SignIn.AuthenticateWithRedirectAsync(strategy, Absolute(SsoCallbackUrl ?? $"{SignInBase}/sso-callback"), Absolute(AfterUrl)));

    private Task Web3Async(string strategy)
    {
        if (strategy == "web3_solana_signature") { _step = Step.Solana; return Task.CompletedTask; }
        return RunAsync(() => Clerk.SignIn.AuthenticateWithWeb3Async(strategy, AfterUrl));
    }

    private Task SolanaAsync(string wallet) => RunAsync(() => Clerk.SignIn.AuthenticateWithWeb3Async("web3_solana_signature", AfterUrl, wallet));

    private void ForgotAsync()
    {
        Error = null;
        var factors = ResetFactors.ToList();
        if (factors.Count == 1) _ = StartResetAsync(factors[0]);
        else _step = Step.ForgotPassword;
    }

    private Task StartResetAsync(SignInFactor f) => RunAsync(async () =>
    {
        _factor = f;
        _attempt = await Clerk.SignIn.PrepareFirstFactorAsync(f);
        _step = Step.ResetCode;
    });

    private Task SubmitNewPasswordAsync()
    {
        _mismatch = _newPassword != _confirmPassword ? L.PasswordsDoNotMatch : null;
        if (_mismatch is not null) return Task.CompletedTask;
        return RunAsync(async () => await ApplyAsync(await Clerk.SignIn.ResetPasswordAsync(_newPassword!, _signOutOthers)));
    }

    private Task ChooseSecondFactorAsync(SignInFactor f) => RunAsync(() => ChooseSecondFactorCoreAsync(f));

    private async Task ChooseSecondFactorCoreAsync(SignInFactor f)
    {
        _factor = f;
        _code = null;
        if (f.Strategy is "phone_code" or "email_code")
            _attempt = await Clerk.SignIn.PrepareSecondFactorAsync(f);
    }

    public override void Dispose()
    {
        _emailLinkCts?.Cancel();
        base.Dispose();
    }
}
