@namespace Clerk.Blazor.Components
@inherits ClerkComponentBase
@using Microsoft.AspNetCore.Components.Routing

<div class="@RootClass("cb-profile")" style="@RootStyle" data-cb-theme="@ThemeAttr" @attributes="AdditionalAttributes">
    <CascadingValue Value="_registry" IsFixed="true">@CustomPages @ChildContent</CascadingValue>
    <nav class="cb-profile__nav" role="tablist" aria-label="@L.ManageAccount">
        <div class="cb-profile__nav-title">@L.ManageAccount</div>
            @foreach (var tab in Tabs)
            {
                <button type="button" class="cb-profile__tab" id="@TabId(tab.Url)" role="tab" aria-selected="@(_page == tab.Url ? "true" : "false")"
                        aria-controls="@_panelId" tabindex="@(_page == tab.Url || (tab.Url == "account" && !Tabs.Any(t => t.Url == _page)) ? 0 : -1)" @ref="_tabElements[tab.Url]" @onkeydown="e => TabKeyDownAsync(e, tab.Url)" @onclick="() => Select(tab.Url)">@tab.Icon @tab.Label</button>
            }
        @foreach (var link in _registry.Entries.Values.Where(e => e.IsLink).ToArray())
        { <a class="cb-profile__tab" href="@link.Url">@link.Icon @link.Label</a> }
    </nav>
    <main class="cb-profile__main" id="@_panelId" role="tabpanel" aria-labelledby="@TabId(_page)" tabindex="0">
        @if (State.User is { } user)
        {
            <h1 class="cb-profile__title">@CurrentTitle</h1>
            @switch (_page)
            {
                case "account": <UserAccountSettings @key="user.Id" /> break;
                case "security": <UserSecuritySettings @key="user.Id" /> break;
                case "billing" when BillingContent is not null && Env.Billing.UserEnabled: @BillingContent break;
                case "api-keys" when ApiKeysContent is not null && Env.ApiKeys.UserEnabled: @ApiKeysContent break;
                default:
                    @if (CurrentCustom is { } custom) { @custom.Content }
                    else { <p class="cb-empty">@L.NoResults</p> }
                    break;
            }
        }
        else { <p class="cb-empty" role="status">@(State.IsLoaded ? L.UserSignInRequired : L.Loading)</p> }
        <Alert Message="@GlobalError()" />
    </main>
</div>

@code {
    /// <summary>Path requires a host catch-all route; Virtual keeps selection inside the component.</summary>
    [Parameter] public ClerkRouting Routing { get; set; } = ClerkRouting.Virtual;
    /// <summary>The mounted profile URL when using Path routing.</summary>
    [Parameter] public string? Path { get; set; }
    [Parameter] public string? InitialPage { get; set; }
    /// <summary>Declarative UserProfilePage and UserProfileLink children.</summary>
    [Parameter] public RenderFragment? CustomPages { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? BillingContent { get; set; }
    [Parameter] public RenderFragment? ApiKeysContent { get; set; }
    private readonly UserProfileRegistry _registry = new();
    private readonly string _panelId = "cb-user-profile-" + Guid.NewGuid().ToString("N");
    private readonly Dictionary<string, ElementReference> _tabElements = [];
    private string _page = "account";
    private string? _previousInitial;
    private IEnumerable<UserProfileEntry> Tabs
    {
        get
        {
            yield return new(L.AccountTitle, "account", null, null, false);
            yield return new(L.SecurityTitle, "security", null, null, false);
            if (BillingContent is not null && Env.Billing.UserEnabled) yield return new(L.BillingTitle, "billing", null, BillingContent, false);
            if (ApiKeysContent is not null && Env.ApiKeys.UserEnabled) yield return new(L.ApiKeysTitle, "api-keys", null, ApiKeysContent, false);
            foreach (var custom in _registry.Entries.Values.Where(e => !e.IsLink).ToArray()) yield return custom;
        }
    }
    private UserProfileEntry? CurrentCustom => _registry.Entries.Values.FirstOrDefault(e => !e.IsLink && e.Url == _page);
    private string CurrentTitle => Tabs.FirstOrDefault(t => t.Url == _page)?.Label ?? L.AccountTitle;
    private string TabId(string page) => _panelId + "-" + Uri.EscapeDataString(page);
    protected override void OnInitialized()
    {
        base.OnInitialized();
        _registry.Changed = () => _ = InvokeAsync(StateHasChanged);
        Navigation.LocationChanged += LocationChanged;
        _page = InitialPage?.Trim('/') is { Length: > 0 } initial ? initial : ReadPage();
        _previousInitial = InitialPage;
    }
    protected override void OnParametersSet()
    {
        if (_previousInitial != InitialPage)
        { _previousInitial = InitialPage; _page = InitialPage?.Trim('/') is { Length: > 0 } p ? p : "account"; }
    }
    private string ReadPage()
    {
        if (Routing != ClerkRouting.Path) return "account";
        var current = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        var root = Navigation.ToAbsoluteUri(Path ?? Clerk.Options.UserProfileUrl).AbsolutePath.TrimEnd('/');
        return current.StartsWith(root + "/", StringComparison.OrdinalIgnoreCase) ? Uri.UnescapeDataString(current[(root.Length + 1)..]) : "account";
    }
    private void Select(string page)
    {
        _page = page;
        Error = null;
        if (Routing == ClerkRouting.Path)
            Navigation.NavigateTo((Path ?? Clerk.Options.UserProfileUrl).TrimEnd('/') + (page == "account" ? "" : "/" + page), replace: true);
    }
    private async Task TabKeyDownAsync(KeyboardEventArgs args, string current)
    {
        var tabs = Tabs.Select(t => t.Url).ToList();
        var index = tabs.IndexOf(current);
        var next = args.Key switch
        {
            "ArrowDown" or "ArrowRight" => (index + 1) % tabs.Count,
            "ArrowUp" or "ArrowLeft" => (index + tabs.Count - 1) % tabs.Count,
            "Home" => 0,
            "End" => tabs.Count - 1,
            _ => -1,
        };
        if (next < 0) return;
        Select(tabs[next]);
        if (_tabElements.TryGetValue(tabs[next], out var element)) await element.FocusAsync();
    }
    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (Routing == ClerkRouting.Path) _ = InvokeAsync(() => { _page = ReadPage(); StateHasChanged(); });
    }
    public override void Dispose() { Navigation.LocationChanged -= LocationChanged; _registry.Changed = null; base.Dispose(); }
}
