@namespace Clerk.Blazor.Components
@inherits ClerkComponentBase

@* Conditionally renders content based on auth state, roles, permissions, features, plans or reverification (<Show>). *@
@if (State.IsLoaded)
{
    if (Matches()) { @ChildContent }
    else { @Fallback }
}

@code {
    /// <summary>Basic condition. Defaults to <see cref="ShowWhen.SignedIn"/>.</summary>
    [Parameter] public ShowWhen When { get; set; } = ShowWhen.SignedIn;
    [Parameter] public string? Role { get; set; }
    [Parameter] public string? Permission { get; set; }
    [Parameter] public string? Feature { get; set; }
    [Parameter] public string? Plan { get; set; }
    [Parameter] public ReverificationPreset? Reverification { get; set; }
    /// <summary>Custom authorization predicate (equivalent to <c>when={(has) =&gt; …}</c>).</summary>
    [Parameter] public Func<ClerkAuth, bool>? Condition { get; set; }
    /// <summary>Overrides <see cref="ClerkOptions.TreatPendingAsSignedOut"/> for this check.</summary>
    [Parameter] public bool? TreatPendingAsSignedOut { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Fallback { get; set; }

    private bool Matches()
    {
        var pendingAsOut = TreatPendingAsSignedOut ?? Clerk.Options.TreatPendingAsSignedOut;
        var session = State.Session;
        var signedIn = session is not null && (session.Status == "active" || (session.IsPending && !pendingAsOut));
        if (When == ShowWhen.SignedOut) return !signedIn;
        if (!signedIn) return false;
        var auth = ClerkState.From(new ClerkSnapshot
        {
            Loaded = State.IsLoaded, Session = session, User = State.User,
            Organization = State.Organization, Membership = State.Membership,
        }, pendingAsOut).Auth;
        if (Role is not null || Permission is not null || Feature is not null || Plan is not null || Reverification is not null)
        {
            var check = new ClerkCheck
            {
                Role = Role, Permission = Permission, Feature = Feature, Plan = Plan,
                Reverification = Reverification is { } r ? ReverificationRequirement.FromPreset(r) : null,
            };
            if (!auth.Has(check)) return false;
        }
        return Condition?.Invoke(auth) ?? true;
    }
}
