@namespace Clerk.Blazor.Components
@inherits ClerkComponentBase

<div class="@RootClass("cb-task-choose-organization")" style="@RootStyle" data-cb-theme="@ThemeAttr" @attributes="AdditionalAttributes">
    @if (_creating)
    {
        <CreateOrganization Routing="ClerkRouting.Virtual" SkipInvitationScreen="true" OnComplete="CreatedAsync" />
        <Btn Variant="ghost" OnClick="() => _creating = false">@L.Back</Btn>
    }
    else
    {
        <Card Title="@L.ChooseOrganizationTask">
            <Alert Message="@GlobalError()" />
            <OrganizationChoices HidePersonal="true" AfterSelectOrganizationUrl="@(RedirectUrlComplete ?? Clerk.Options.SignInFallbackRedirectUrl)" OnCreate="() => _creating = true" />
            <Btn Variant="ghost" Busy="@Busy" OnClick="SignOutAsync">@L.SignOut</Btn>
        </Card>
    }
</div>

@code {
    [Parameter] public string? RedirectUrlComplete { get; set; }
    private bool _creating;
    private Task SelectedAsync(ClerkOrganization? organization) => RunAsync(() => Clerk.Organization.SetActiveAsync(organization?.Id, RedirectUrlComplete ?? Clerk.Options.SignInFallbackRedirectUrl));
    private Task CreatedAsync(ClerkOrganization organization) => SelectedAsync(organization);
    private Task SignOutAsync() => RunAsync(async () => { await Clerk.SignOutAsync(); Clerk.RedirectToAfterSignOut(); });
}
