@namespace Clerk.Blazor.Components
@inherits ClerkComponentBase

<div class="@RootClass("cb-task-reset-password")" style="@RootStyle" data-cb-theme="@ThemeAttr" @attributes="AdditionalAttributes">
    <Card Title="@L.ResetPasswordTitle" Subtitle="@L.ResetPasswordTask">
        <ChildContent>
            @if (State.Session is null) { <p>@(State.IsLoaded ? L.UserSignInRequired : L.Loading)</p> }
            else
            {
                <form class="cb-form" @onsubmit="CompleteAsync" @onsubmit:preventDefault>
                    @if (!_updated)
                    {
                    <Field Label="@L.NewPassword" Type="password" @bind-Value="_password" Autocomplete="new-password" Required Disabled="Busy" ShowLabel="@L.ShowPassword" HideLabel="@L.HidePassword" />
                    <Field Label="@L.ConfirmPassword" Type="password" @bind-Value="_confirmation" Autocomplete="new-password" Required Disabled="Busy" ShowLabel="@L.ShowPassword" HideLabel="@L.HidePassword" />
                    <label class="cb-check"><input type="checkbox" @bind="_signOutOthers" disabled="@Busy" />@L.SignOutOtherSessions</label>
                    }
                    else { <p role="status">@L.UserPasswordUpdated</p> }
                    <Alert Message="@GlobalError()" />
                    <Btn Type="submit" Block Busy="Busy">@L.Continue</Btn>
                </form>
            }
        </ChildContent>
        <Footer><button type="button" class="cb-link" disabled="@Busy" @onclick="SignOutAsync">@L.SignOut</button></Footer>
    </Card>
</div>

@code {
    [Parameter] public string? RedirectUrlComplete { get; set; }
    [Parameter] public EventCallback OnComplete { get; set; }
    private string _password = "", _confirmation = "";
    private bool _signOutOthers = true, _updated;
    private async Task CompleteAsync()
    {
        if (State.Session is not { } session) return;
        await RunAsync(async () =>
        {
            if (!_updated)
            {
                if (_password != _confirmation) throw new ClerkException("password_mismatch", L.PasswordsDoNotMatch);
                await Clerk.User.UpdatePasswordAsync(_password, signOutOfOtherSessions: _signOutOthers);
                _password = ""; _confirmation = ""; _updated = true;
            }
            await Clerk.SetActiveAsync(new SetActiveOptions { SessionId = session.Id, RedirectUrl = RedirectUrlComplete ?? Clerk.Options.SignInFallbackRedirectUrl });
            await OnComplete.InvokeAsync();
        });
    }
    private Task<bool> SignOutAsync() => RunAsync(() => Clerk.SignOutAsync(State.Session?.Id));
}
