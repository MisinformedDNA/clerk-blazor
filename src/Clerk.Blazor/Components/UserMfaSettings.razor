@namespace Clerk.Blazor.Components
@inherits ClerkComponentBase

<div class="@RootClass("cb-stack")" style="@RootStyle" data-cb-theme="@ThemeAttr" @attributes="AdditionalAttributes">
    @if (State.User is { } user)
    {
        @if (_secret is not null)
        {
            <p>@L.UserAuthenticatorInstructions</p>
            <code class="cb-secret cb-mono">@_secret.Secret</code>
            <button type="button" class="cb-link" disabled="@Busy" @onclick="() => CopyAsync(_secret.Secret ?? string.Empty)">@L.Copy</button>
            @if (_secret.Uri is { } uri)
            {
                <span>@L.UserAuthenticatorUri</span><code class="cb-secret cb-mono">@uri</code>
            }
            <form class="cb-form" @onsubmit="VerifyTotpAsync" @onsubmit:preventDefault>
                <Field Label="@L.Code" @bind-Value="_code" Autocomplete="one-time-code" InputMode="numeric" Required Disabled="Busy" />
                <div class="cb-actions"><Btn Variant="outline" Disabled="Busy" OnClick="CancelTotp">@L.Cancel</Btn><Btn Type="submit" Busy="Busy">@L.Verify</Btn></div>
            </form>
        }
        else if (user.TotpEnabled)
        {
            <span class="cb-badge cb-badge--success">@L.UseAuthenticator</span>
            @if (!TaskMode) { <UserConfirmAction Label="@L.UserDisableAuthenticator" Disabled="Busy" OnConfirm="DisableTotpAsync" /> }
        }
        else if (Env.Attribute("authenticator_app").Enabled || Env.Attribute("totp").Enabled)
        {
            <Btn Variant="outline" Disabled="Busy" OnClick="CreateTotpAsync">@L.AddAuthenticator</Btn>
        }
        @if (Env.Attribute("phone_number").UsedForSecondFactor)
        {
            @foreach (var phone in user.PhoneNumbers.Where(p => p.Verification?.IsVerified == true))
            {
                <div class="cb-spread" @key="phone.Id">
                    <span>@phone.PhoneNumber</span>
                    @if (phone.ReservedForSecondFactor)
                    {
                        <span class="cb-badge cb-badge--success">@L.TwoStepVerification</span>
                        @if (!TaskMode) { <UserConfirmAction Label="@L.UserDisableSms" Disabled="Busy" OnConfirm="() => SmsAsync(phone.Id, false)" /> }
                    }
                    else { <Btn Variant="outline" Disabled="Busy" OnClick="() => SmsAsync(phone.Id, true)">@L.UserSmsSetup</Btn> }
                </div>
            }
            @if (!user.PhoneNumbers.Any(p => p.Verification?.IsVerified == true))
            {
                <p>@L.UserVerifiedPhoneRequired</p>
                @if (TaskMode) { <UserContactMethods Phone="true" SetupSecondFactor="true" OnConfigured="ConfiguredAsync" /> }
            }
        }
        @if (user.TwoFactorEnabled || user.TotpEnabled || user.PhoneNumbers.Any(p => p.ReservedForSecondFactor) || _configured)
        {
            @if (!TaskMode) { <UserConfirmAction Label="@L.RegenerateBackupCodes" Disabled="Busy" OnConfirm="RegenerateAsync" /> }
            @if (_codes.Count > 0)
            {
                <h3>@L.BackupCodes</h3><p>@L.BackupCodesHint</p>
                <ul class="cb-codes">@foreach (var code in _codes) { <li class="cb-mono">@(code)</li> }</ul>
                <div class="cb-inline">
                    <button type="button" class="cb-link" disabled="@Busy" @onclick="() => CopyAsync(string.Join(Environment.NewLine, _codes))">@L.Copy</button>
                    <a class="cb-link" href="@CodesDownload" download="backup-codes.txt">@L.UserDownloadCodes</a>
                </div>
            }
            @if (TaskMode) { <Btn Busy="Busy" OnClick="FinishAsync">@L.Continue</Btn> }
        }
        else if (!Env.Attribute("authenticator_app").Enabled && !Env.Attribute("totp").Enabled && !Env.Attribute("phone_number").UsedForSecondFactor)
        { <p>@L.UserMfaUnavailable</p> }
    }
    @if (_copied) { <p role="status">@L.Copied</p> }
    <Alert Message="@GlobalError()" />
</div>

@code {
    [Parameter] public bool TaskMode { get; set; }
    [Parameter] public EventCallback OnComplete { get; set; }
    private TotpSecret? _secret;
    private string _code = "";
    private IReadOnlyList<string> _codes = [];
    private bool _configured, _copied;
    private string CodesDownload => "data:text/plain;charset=utf-8," + Uri.EscapeDataString(string.Join(Environment.NewLine, _codes));
    private Task<bool> CreateTotpAsync() => RunAsync(async () => { _secret = await Clerk.User.CreateTotpAsync(); _code = ""; _codes = []; _copied = false; });
    private void CancelTotp() { _secret = null; _code = ""; Error = null; }
    private async Task VerifyTotpAsync()
    {
        await RunAsync(async () =>
        {
            var result = await Clerk.User.VerifyTotpAsync(_code.Trim());
            _codes = result.BackupCodes ?? _secret?.BackupCodes ?? [];
            _secret = null; _code = ""; _configured = true;
            if (_codes.Count == 0 && !State.User!.BackupCodeEnabled) _codes = await Clerk.User.CreateBackupCodesAsync();
        });
    }
    private Task<bool> DisableTotpAsync() => RunAsync(async () => { await Clerk.User.DisableTotpAsync(); _codes = []; _configured = false; });
    private Task<bool> RegenerateAsync() => RunAsync(async () => { _codes = await Clerk.User.CreateBackupCodesAsync(); _copied = false; });
    private Task<bool> SmsAsync(string id, bool enabled) => RunAsync(async () =>
    {
        await Clerk.User.SetPhoneReservedForSecondFactorAsync(id, enabled);
        _configured = enabled;
        if (enabled && !State.User!.BackupCodeEnabled) _codes = await Clerk.User.CreateBackupCodesAsync();
    });
    private Task ConfiguredAsync() { _configured = true; return Task.CompletedTask; }
    private Task<bool> FinishAsync() => RunAsync(() => OnComplete.InvokeAsync());
    private Task<bool> CopyAsync(string text) => RunAsync(async () =>
    {
        _copied = await (await Clerk.BridgeModuleAsync()).InvokeAsync<bool>("copyToClipboard", text);
        if (!_copied) throw new ClerkException("clipboard_failed", L.UserClipboardFailed);
    });
    public override void Dispose() { _secret = null; _codes = []; _code = ""; base.Dispose(); }
}
