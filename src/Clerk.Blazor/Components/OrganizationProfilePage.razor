@namespace Clerk.Blazor.Components
@inherits ClerkComponentBase

<span hidden class="@RootClass("cb-organization-profile-page")" style="@RootStyle" data-cb-theme="@ThemeAttr" @attributes="AdditionalAttributes"></span>

@code {
    [CascadingParameter] public OrganizationProfileRegistration? Registration { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Url { get; set; } = "";
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private OrganizationProfileRegistration? _registered;
    protected override void OnParametersSet()
    {
        if (_registered == Registration) return;
        _registered?.Remove(this); _registered = Registration; _registered?.Register(this);
    }
    public override void Dispose() { _registered?.Remove(this); base.Dispose(); }
}
