@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 auth">
            <Show When="ShowWhen.SignedIn">
                <OrganizationSwitcher />
                <UserButton ShowName />
            </Show>
            <Show When="ShowWhen.SignedOut">
                <SignInButton Mode="ClerkButtonMode.Modal" />
                <SignUpButton />
            </Show>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
